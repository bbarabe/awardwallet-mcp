{
  "name": "awardwallet",
  "displayName": "AwardWallet",
  "version": "0.1.0",
  "description": "Unofficial AwardWallet plugin: loyalty balances, elite status, expirations, account history and trips from AwardWallet, plus every AwardWallet API. Runs on your computer; your API key stays there.",
  "author": {
    "name": "Benoit Barabe",
    "url": "https://github.com/bbarabe"
  },
  "homepage": "https://github.com/bbarabe/awardwallet-mcp",
  "repository": "https://github.com/bbarabe/awardwallet-mcp",
  "license": "MIT",
  "keywords": ["awardwallet", "loyalty", "miles", "points", "travel", "rewards"],
  "mcpServers": {
    "awardwallet": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/awardwallet-mcp",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/awardwallet-mcp.mjs"],
      "env": { "PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}" }
    }
  }
}
